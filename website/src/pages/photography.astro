---
import Base from '../layouts/Base.astro';
import PhotoLightbox from '../components/PhotoLightbox';
import '../styles/global.css';
import { publishedPhotos, siteText } from '../lib/content';

const [photos, subhead] = await Promise.all([
  publishedPhotos(),
  siteText('photography_subhead', 'A living collection of images. Albums and descriptions are managed privately and will grow over time.'),
]);
---
<Base title="Photography — Christo Esser">
  <div class="container">
    <section class="section">
      <span class="eyebrow">ls ./photography</span>
      <h1 style="font-size:clamp(3rem,9vw,8rem);letter-spacing:-.02em;line-height:.9;margin:18px 0">Light, place,<br />and timing.</h1>
      <p class="muted" style="max-width:480px;line-height:1.7">{subhead}</p>
    </section>
    <section class="section">
      {photos.length ? (
        <div class="gallery">
          <PhotoLightbox client:load photos={photos} />
        </div>
      ) : (
        <p class="muted">No published photographs yet. Add the first album from the admin dashboard.</p>
      )}
    </section>
  </div>
</Base>
