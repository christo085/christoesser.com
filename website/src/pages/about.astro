---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
import { siteText } from '../lib/content';

const [headline, bio] = await Promise.all([
  siteText('about_headline', 'Developer. Designer. Maker.'),
  siteText('about_bio', 'I’m Christo Esser, a developer, designer, and maker from Edinburgh, Scotland. I’m passionate about photography and cinematography, which I share on my YouTube channel, as well as 3D printing, engineering, and CAD. I’ve trained and competed in judo for over eight years.'),
]);
---
<Base title="About — Christo Esser">
  <div class="container">
    <section class="section">
      <span class="eyebrow">About</span>
      <h1 class="page-title">{headline}</h1>
      <div class="about-copy">
        <p>{bio}</p>
      </div>
    </section>
    <section class="section">
      <dl class="spec-list">
        <div class="spec-row">
          <dt>Practice</dt>
          <dd>Web development, software, design, 3D printing, photography, filmmaking, and technology.</dd>
        </div>
        <div class="spec-row">
          <dt>Approach</dt>
          <dd>Learning by experimenting, with a focus on useful things that work in the real world.</dd>
        </div>
        <div class="spec-row">
          <dt>Beyond making</dt>
          <dd>Judo for over eight years — currently a 14th Mon — and competitive speedcubing, including official WCA competitions.</dd>
        </div>
      </dl>
    </section>
  </div>
</Base>
