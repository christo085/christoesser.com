---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
---
<Base title="Page not found — Christo Esser">
  <div class="container">
    <section class="section not-found">
      <span class="eyebrow">404</span>
      <h1 class="page-title">That page<br /><em>isn’t here.</em></h1>
      <p class="page-intro muted">The link may be out of date, or the page may have moved.</p>
      <a class="button" href="/">Back to the homepage ↗</a>
    </section>
  </div>
</Base>
