---
import Base from '../layouts/Base.astro'; import '../styles/global.css'; import { publishedProjects, publishedPhotos } from '../lib/content';
const [projects, photos] = await Promise.all([publishedProjects(), publishedPhotos()]);
---
<Base><div class="container"><section class="hero"><div><span class="eyebrow">Christo Esser / 2026</span><h1>Hi, I'm Christo.</h1><p>A personal headquarters for the things I photograph, film, design, engineer, and build.</p><a class="button" href="/projects">Explore the work ↗</a></div><div class="hero-mark" aria-hidden="true"></div></section><section class="section"><div class="section-heading"><h2>Selected frames</h2><a class="muted" href="/photography">View photography ↗</a></div>{photos.length ? <div class="gallery">{photos.slice(0,6).map((photo) => <figure><img src={photo.image_url ?? ''} alt={photo.title ?? 'Photograph by Christo Esser'} loading="lazy" /><figcaption>{photo.title}</figcaption></figure>)}</div> : <p class="muted">The gallery is being composed. New frames will appear here soon.</p>}</section><section class="section"><div class="section-heading"><h2>Things I build</h2><a class="muted" href="/projects">All projects ↗</a></div>{projects.length ? <div class="grid">{projects.slice(0,4).map((project) => <article class="card"><span class="tag">{project.category}</span><h3>{project.title}</h3><p class="muted">{project.description}</p></article>)}</div> : <p class="muted">Projects will be added through the private dashboard.</p>}</section><section class="section"><span class="eyebrow">A little context</span><h2>Creative technology,<br />with a human edge.</h2><p class="muted" style="max-width:520px;line-height:1.7">Photography, filmmaking, code, physical making, and the systems that connect them. This is a space for experiments, finished work, and the ideas in between.</p><a class="button" href="/about">More about me ↗</a></section></div></Base>
