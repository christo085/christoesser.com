---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
import { publishedProjects, publishedPhotos, siteText } from '../lib/content';

const [projects, photos, heroSubhead] = await Promise.all([
  publishedProjects(),
  publishedPhotos(),
  siteText('hero_subhead', 'Photographer, filmmaker, and builder of software and hardware.'),
]);
---
<Base>
  <div class="container">
    <section class="hero">
      <div>
        <span class="eyebrow">whoami</span>
        <h1>Hi, I'm<br />Christo.</h1>
        <p>{heroSubhead}</p>
        <a class="button" href="/projects">Explore the work &rarr;</a>
      </div>
      <div>
        <dl class="hero-meta">
          <div class="hero-meta-row">
            <dt>Focus</dt>
            <dd>Photography / Film / Code / Making</dd>
          </div>
          <div class="hero-meta-row">
            <dt>Build</dt>
            <dd>Self-hosted, from scratch</dd>
          </div>
          <div class="hero-meta-row">
            <dt>Status</dt>
            <dd>Portfolio v2026</dd>
          </div>
        </dl>
        <div class="reticle" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div class="section-heading-left">
          <span class="section-index">01</span>
          <h2>Selected frames</h2>
        </div>
        <a class="section-link" href="/photography">View photography &rarr;</a>
      </div>
      {photos.length ? (
        <div class="gallery">
          {photos.slice(0, 6).map((photo, index) => (
            <figure>
              <span class="frame-index">F.{String(index + 1).padStart(2, '0')}</span>
              <img src={photo.image_url ?? ''} alt={photo.title ?? 'Photograph by Christo Esser'} loading="lazy" />
              <figcaption>{photo.title || 'Untitled'}</figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <p class="muted">The gallery is being composed. New frames will appear here soon.</p>
      )}
    </section>

    <section class="section">
      <div class="section-heading">
        <div class="section-heading-left">
          <span class="section-index">02</span>
          <h2>Things I build</h2>
        </div>
        <a class="section-link" href="/projects">All projects &rarr;</a>
      </div>
      {projects.length ? (
        <div class="grid">
          {projects.slice(0, 4).map((project, index) => (
            <article class="card">
              <span class="card-index">P.{String(index + 1).padStart(2, '0')}</span>
              <span class="tag">{project.category}</span>
              <h3>{project.title}</h3>
              <p class="muted">{project.description}</p>
            </article>
          ))}
        </div>
      ) : (
        <p class="muted">Projects will be added through the private dashboard.</p>
      )}
    </section>
  </div>
</Base>
