---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
import { publishedProjects, siteText } from '../lib/content';

const [projects, heroSubhead] = await Promise.all([
  publishedProjects(),
  siteText('hero_subhead', 'A young developer, designer, and maker based in Edinburgh, Scotland. I work across software, web development, 3D printing, film, and technology.'),
]);
---
<Base>
  <div class="container">
    <section class="hero">
      <div>
        <span class="eyebrow">Christo Esser · Edinburgh</span>
        <h1>I’m Christo Esser</h1>
        <p>{heroSubhead}</p>
        <a class="button" href="/projects">See what I’m building <span aria-hidden="true">↗</span></a>
      </div>
      <div>
        <p class="hero-note">Web projects, 3D prints, experiments, and work in progress.</p>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div class="section-heading-left">
          <h2>Selected projects</h2>
        </div>
        <a class="section-link" href="/projects">All projects &rarr;</a>
      </div>
      {projects.length ? (
        <div class="grid">
          {projects.slice(0, 4).map((project) => (
            <article class="card">
              <span class="tag">{project.category}</span>
              <h3>{project.title}</h3>
              <p class="muted">{project.description}</p>
            </article>
          ))}
        </div>
      ) : (
        <p class="muted">I’m documenting projects, experiments, and the things I learn while making them.</p>
      )}
    </section>

    <section class="section callout-section">
      <div>
        <span class="eyebrow">Photography</span>
        <h2>Photos and<br /><em>occasional updates.</em></h2>
      </div>
      <a class="button" href="https://whatsapp.com/channel/0029VakbvKzBadmXIrH7yy1M" target="_blank" rel="noopener noreferrer">Photography on WhatsApp ↗</a>
    </section>
  </div>
</Base>
